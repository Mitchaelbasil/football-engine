 "intros": [],
 "beats": [
  {
   "t": 0.25,
   "end": 2.128,
   "say": "How do you steal your rival's best player?",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/a6a5771e039dcabc.wav",
   "scene": 0,
   "speaker": "H"
  },
  {
   "t": 2.888,
   "end": 7.929,
   "say": "With a promise. Florentino Perez was running to be Real Madrid's president.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/804bb5d758a51720.wav",
   "scene": 1,
   "speaker": "P"
  },
  {
   "t": 8.089,
   "end": 13.008,
   "say": "He promised the members Figo. And if he failed, he would pay for their season tickets.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/1d2d9cd33a1ef7d8.wav",
   "scene": 1,
   "speaker": "P"
  },
  {
   "t": 13.168,
   "end": 14.775,
   "say": "He won. And Figo came.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/3974d4e33b4284dc.wav",
   "scene": 1,
   "speaker": "P"
  },
  {
   "t": 17.725,
   "end": 21.143,
   "say": "Two years later, Figo went back to the Camp Now, in white.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/8e8e92e13fd4fd84.wav",
   "scene": 2,
   "speaker": "H"
  },
  {
   "t": 21.303,
   "end": 25.282,
   "say": "Every time he went to take a corner, things rained down from the stands.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/84494bf3f55aed76.wav",
   "scene": 2,
   "speaker": "H"
  },
  {
   "t": 25.442,
   "end": 26.708,
   "say": "Including a pig's head.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/1872875aa429038f.wav",
   "scene": 2,
   "speaker": "H"
  }
 ],
