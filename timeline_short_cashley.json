 "beats": [
  {
   "t": 0.25,
   "end": 2.866,
   "say": "Arsenal offered him fifty-five thousand a week.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/bea99072d58cd2cf.wav",
   "scene": 0,
   "speaker": "H"
  },
  {
   "t": 3.626,
   "end": 9.618,
   "say": "He came through Arsenal's academy, and played left-back for the team that went a whole league season unbeaten.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/f28dc45c54e80753.wav",
   "scene": 1,
   "speaker": "H"
  },
  {
   "t": 10.378,
   "end": 15.021,
   "say": "Then Arsenal offered him a new contract. Fifty-five thousand pounds a week.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/fc6f8299de94cd07.wav",
   "scene": 2,
   "speaker": "H"
  },
  {
   "t": 15.181,
   "end": 18.325,
   "say": "He felt it was far below his worth, and joined Chelsea.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/586e3779b3033ac7.wav",
   "scene": 2,
   "speaker": "H"
  },
  {
   "t": 20.675,
   "end": 23.562,
   "say": "Arsenal fans had a new name for him. Cashley.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/villains-opening/build/voice_kokoro_af_bella/4bd5bc0988bd4f8a.wav",
   "scene": 2,
   "speaker": "H"
  }
 ],
