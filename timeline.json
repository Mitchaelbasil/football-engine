 "beats": [
  {
   "t": 0.25,
   "end": 3.979,
   "say": "There were nineteen other teams in La Liga that season.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/dbea31422299b5c8.wav",
   "scene": 0
  },
  {
   "t": 4.139,
   "end": 7.441,
   "say": "Ronaldo scored against every single one of them.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/1fef88f15b8459e2.wav",
   "scene": 0
  },
  {
   "t": 8.401,
   "end": 11.747,
   "say": "Nobody in the league's history had ever done that.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/d8ec023faf35f2ee.wav",
   "scene": 0
  },
  {
   "t": 13.107,
   "end": 17.289,
   "say": "April twenty-first. The Camp Now, with the title on the line.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/06ce7b78709fb9eb.wav",
   "scene": 1
  },
  {
   "t": 17.449,
   "end": 20.04,
   "say": "Sami Kedeera put Madrid ahead.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/d92ecfde6630d00f.wav",
   "scene": 1
  },
  {
   "t": 20.2,
   "end": 23.893,
   "say": "With twenty minutes left, Alexis Sanchez equalised.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/85053e207aad302a.wav",
   "scene": 1
  },
  {
   "t": 24.053,
   "end": 26.843,
   "say": "Three minutes later, Ronaldo ended it.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/45831ff99ff5f913.wav",
   "scene": 1
  },
  {
   "t": 28.403,
   "end": 31.501,
   "say": "Madrid took the league with a hundred points.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/b4760dbd9b256559.wav",
   "scene": 2
  },
  {
   "t": 31.661,
   "end": 34.005,
   "say": "Nine clear of Barcelona.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/3137eacd525cc0bd.wav",
   "scene": 2
  },
  {
   "t": 35.365,
   "end": 39.947,
   "say": "Four days later, it came down to penalties against Byern Munich.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/b70be1fb19aec969.wav",
   "scene": 3
  },
  {
   "t": 40.107,
   "end": 44.062,
   "say": "Ronaldo went first for Madrid, and Manuel Noyer saved it.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/b9f28f88392c8351.wav",
   "scene": 3
  },
  {
   "t": 44.222,
   "end": 46.587,
   "say": "Madrid missed three of their four.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/be2cf24fdbeab6e5.wav",
   "scene": 3
  },
  {
   "t": 47.947,
   "end": 49.071,
   "say": "No final.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_templates/build/voice_kokoro_bm_george/107a6a66169a78c3.wav",
   "scene": 3
  }
 ],
