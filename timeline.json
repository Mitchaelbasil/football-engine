 "beats": [
  {
   "t": 0.25,
   "end": 1.229,
   "say": "Sixty goals.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/39a29fa2a0c45d66.wav",
   "scene": 0,
   "speaker": "H"
  },
  {
   "t": 1.589,
   "end": 2.856,
   "say": "In fifty-five games.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/43f430b32e34070e.wav",
   "scene": 0,
   "speaker": "H"
  },
  {
   "t": 3.616,
   "end": 4.694,
   "say": "He broke records.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/51b637cde961a015.wav",
   "scene": 1,
   "speaker": "H"
  },
  {
   "t": 4.854,
   "end": 5.732,
   "say": "He won the league.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/25db4fc8fd00cd5a.wav",
   "scene": 1,
   "speaker": "H"
  },
  {
   "t": 5.892,
   "end": 7.962,
   "say": "He scored against every single team.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/7b6dd171f6d171c2.wav",
   "scene": 1,
   "speaker": "H"
  },
  {
   "t": 8.722,
   "end": 10.155,
   "say": "And he still finished second.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/e959fd8c4439d2e3.wav",
   "scene": 2,
   "speaker": "H"
  },
  {
   "t": 13.105,
   "end": 15.515,
   "say": "This is the arc where sixty wasn't enough.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/8cdd12197d721d4b.wav",
   "scene": 3,
   "speaker": "H"
  },
  {
   "t": 16.675,
   "end": 21.445,
   "say": "For almost any player in history, sixty goals would be the season of a lifetime.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/26535ca611b0f930.wav",
   "scene": 4,
   "speaker": "H"
  },
  {
   "t": 21.905,
   "end": 25.844,
   "say": "But five hundred kilometres away, someone was playing a different game.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/47869f66ee5d7ddc.wav",
   "scene": 4,
   "speaker": "H"
  },
  {
   "t": 26.004,
   "end": 28.31,
   "say": "Lionel Messi. Seventy-three goals.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/e6c1297461b5eea3.wav",
   "scene": 4,
   "speaker": "H"
  },
  {
   "t": 31.26,
   "end": 33.524,
   "say": "But titles aren't decided on spreadsheets.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/6e76a8c0f37b77d8.wav",
   "scene": 5,
   "speaker": "H"
  },
  {
   "t": 33.684,
   "end": 37.886,
   "say": "April twenty-first. Madrid go to the Camp Now with the league on the line.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/bb38af2d2bd98d98.wav",
   "scene": 5,
   "speaker": "H"
  },
  {
   "t": 38.646,
   "end": 43.566,
   "say": "Seventy-third minute. Ronaldo runs through, scores, and turns to the crowd.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/152f18d67db0d926.wav",
   "scene": 6,
   "speaker": "H"
  },
  {
   "t": 43.726,
   "end": 44.486,
   "say": "Calm down.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/ae06ab6649f54934.wav",
   "scene": 6,
   "speaker": "H"
  },
  {
   "t": 47.436,
   "end": 52.441,
   "say": "So he won the league, beat Barcelona in their own stadium, and still finished second.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/7a37a704c8e58446.wav",
   "scene": 7,
   "speaker": "H"
  },
  {
   "t": 53.201,
   "end": 53.67,
   "say": "Why?",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/8dbcb41ca6253af6.wav",
   "scene": 8,
   "speaker": "H"
  },
  {
   "t": 54.53,
   "end": 57.392,
   "say": "Because the Ballon Dor doesn't care who won the league.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/5fa2d2d3bd846e42.wav",
   "scene": 9,
   "speaker": "P"
  },
  {
   "t": 57.552,
   "end": 63.397,
   "say": "Messi didn't win La Liga. He didn't win the Champions League either. He just outscored everybody.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/6e9d66ed62c3fdaa.wav",
   "scene": 9,
   "speaker": "P"
  },
  {
   "t": 63.557,
   "end": 67.227,
   "say": "Fifty league goals. Nobody in Spain had ever done that.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/3dc204bf1218f5a7.wav",
   "scene": 9,
   "speaker": "P"
  },
  {
   "t": 67.987,
   "end": 71.836,
   "say": "And the vote isn't about the season. It's about the calendar year.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/29190ebc95dbdc9e.wav",
   "scene": 10,
   "speaker": "P"
  },
  {
   "t": 72.596,
   "end": 75.667,
   "say": "In twenty twelve, Messi scored ninety-one goals.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/f8957bf9301118fb.wav",
   "scene": 11,
   "speaker": "P"
  },
  {
   "t": 78.017,
   "end": 80.954,
   "say": "Gerd Mueller's record had stood for forty years.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/0b9542f0edd806f7.wav",
   "scene": 11,
   "speaker": "P"
  },
  {
   "t": 81.714,
   "end": 83.592,
   "say": "Ronaldo had the better story.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/64c181054a0ffdad.wav",
   "scene": 12,
   "speaker": "P"
  },
  {
   "t": 83.752,
   "end": 87.517,
   "say": "Messi had the bigger numbers. And the voters went with the numbers.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/003490404e98d730.wav",
   "scene": 12,
   "speaker": "P"
  },
  {
   "t": 87.677,
   "end": 89.117,
   "say": "It wasn't even close.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/1789e85ce314358b.wav",
   "scene": 12,
   "speaker": "P"
  },
  {
   "t": 90.077,
   "end": 93.679,
   "say": "Sixty goals. A league title. Nineteen out of nineteen.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/89a27857b692937d.wav",
   "scene": 13,
   "speaker": "H"
  },
  {
   "t": 93.839,
   "end": 94.975,
   "say": "And still, second.",
   "wav": "/home/runner/work/football-engine/football-engine/0004/videos/_checkpoint/build/voice_kokoro_af_bella/d19ae365bc1248ba.wav",
   "scene": 13,
   "speaker": "H"
  }
 ],
